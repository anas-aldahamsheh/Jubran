# Environment Configuration — Jubran

# Database
# docker-compose.yml creates the database with these (the password is required; pick your own).
POSTGRES_USER=jubran_user
POSTGRES_PASSWORD=choose-a-database-password
POSTGRES_DB=jubran_db
# How the API reaches it (same user/password/database as above).
# `docker compose --profile app` sets this itself for the API container.
DATABASE_URL=postgresql+asyncpg://jubran_user:choose-a-database-password@localhost:5433/jubran_db
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# Environment: "production" (the default when unset) or "development" for a local run.
# Production refuses to start with the placeholder secrets below, DEBUG on,
# SECURE_COOKIES off, or no administrator account.
ENVIRONMENT=development
# DEBUG=false                      # unset: on in development, off in production

# Security & Sessions
# Generate each secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-different-long-random-secret
# Encrypts stored AI keys and printable QR codes; independent of SECRET_KEY (required in production).
# Comma-separated: the first key encrypts, all can decrypt. To rotate, put a new key first, keep the
# old one after it, restart once, then remove the old one. Generate a key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEYS=
SESSION_COOKIE_NAME=jubran_session
# LOGIN_IDLE_TIMEOUT_SECONDS=28800  # sign a login out after 8 hours without use (an open admin screen counts as use)
# TABLE_SESSION_IDLE_HOURS=6          # close a table nobody closed after this many hours without any activity (0 = never)
ADMIN_SESSION_COOKIE_NAME=jubran_admin_session
# SECURE_COOKIES=true              # unset: true in production (HTTPS), false in development
# COOKIE_SAMESITE=lax              # "none" only if the website and API are on different sites (requires HTTPS)
# CORS_ORIGINS=["https://order.example.com"]   # the website address(es) allowed to call the API
# FORWARDED_ALLOW_IPS=127.0.0.1    # address of your HTTPS reverse proxy, so rate limits see visitors' real addresses
# WEB_CONCURRENCY=2                # API worker processes (docker image); all workers share state through the database

# First administrator (production). Created only if this account does not exist yet;
# at least 12 characters. To reset a forgotten password later, run from services/api:
#   python -m jubran.manage create-admin --email owner@example.com
# ADMIN_EMAIL=owner@example.com
# ADMIN_PASSWORD=
# In development the demo sign-ins admin@jubran.jo / admin12345 exist; production disables them.

# AI Providers. Admin > Settings has a section per purpose (chat, menu search, speech to
# text, live voice), each with its own provider, model and key. These are the defaults a
# section uses (and suggests) until it is saved; live voice stays off until switched on.
GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
OPENAI_TEXT_MODEL=gpt-6-luna
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Menu search before its section is saved: auto (a provider this server has a key for), gemini or openai.
EMBEDDING_PROVIDER=auto
SEMANTIC_MIN_SIMILARITY=0.65
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
# Live voice: OpenAI GPT-Live (OpenAI's Live API), which hands each request to the chat assistant.
OPENAI_LIVE_MODEL=gpt-live-1

# Uploaded dish photos are files in this folder (default: services/api/media). Keep it in backups.
# MEDIA_DIR=

# Public demo, for a copy anyone on the internet can try (build the website with
# NEXT_PUBLIC_PUBLIC_DEMO=true too): "Try as a guest" seats each visitor at a free table, a pretend
# kitchen prepares their orders, and the assistant answers this many messages a day in total.
# PUBLIC_DEMO=false
# PUBLIC_DEMO_ASSISTANT_TURNS_PER_DAY=300

# Application Defaults
DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001
API_PORT=8001
WEB_PORT=3001

# Frontend (apps/web) — optional, set in apps/web/.env.local or your hosting environment
# NEXT_PUBLIC_DEMO_MODE=false     # "Try as customer" on Admin > Tables & QR. Default: on with `npm run dev`, off in production builds.
# NEXT_PUBLIC_PUBLIC_DEMO=false   # "Try as a guest" on the sign-in page, for a public demo copy (with PUBLIC_DEMO=true on the API)
# NEXT_PUBLIC_SITE_URL=https://order.example.com   # address printed inside table QR codes (default: the address the admin panel is opened from)
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1  # production API address; also used for the site's Content-Security-Policy (default: port 8001 on the same host)
